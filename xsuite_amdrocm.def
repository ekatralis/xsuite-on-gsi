Bootstrap: docker
From: ubuntu:24.04

# Override at build time, e.g.:
#   apptainer build \
#     --build-arg ROCM_TARBALL_URL=https://.../therock-dist-linux-gfx908-<ver>.tar.gz \
#     xsuite-rocm10-gfx908.sif xsuite-rocm10-gfx908.def
#
# Newer gfx908 TheRock builds are listed at
#   https://rocm.devreleases.amd.com/tarball-multi-arch/
%arguments
    ROCM_TARBALL_URL=https://stable.repo.amd.com/rocm/core/tarball/therock-dist-linux-gfx908-10.2.0.tar.gz
                      #https://nightly.repo.amd.com/rocm/core/tarball/therock-dist-linux-gfx908-10.3.0a20261031.tar.gz
    AMD_PYPI_INDEX=https://pypi.amd.com/rocm-10.0.0/simple/

%labels
    AUTHOR Evangelos Katralis

%help
    See https://git.gsi.de/p.niedermayer/xsuite-on-hpc
    ROCm 10.x (TheRock tarball, gfx908) + amd-cupy + xsuite.

%files
    example.py /xsuite/example.py

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    GPU_ARCH=gfx908
    ROCM_TARBALL_URL="{{ ROCM_TARBALL_URL }}"
    AMD_PYPI_INDEX="{{ AMD_PYPI_INDEX }}"

    # base packages
    ################
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates wget git perl build-essential cmake libssl-dev \
        libnuma1 libnuma-dev libatomic1 libquadmath0 \
        ocl-icd-libopencl1 ocl-icd-opencl-dev clinfo libclfft-dev opencl-headers

    # install ROCm 10.x from a self-contained TheRock tarball (gfx908)
    ###################################################################
    mkdir -p /opt/rocm
    echo "Fetching ROCm: ${ROCM_TARBALL_URL}"
    wget -q -O /tmp/rocm.tar.gz "${ROCM_TARBALL_URL}"
    tar -xzf /tmp/rocm.tar.gz -C /opt/rocm
    rm -f /tmp/rocm.tar.gz

    # sanity check: make sure the tarball really targets our arch
    ls /opt/rocm/lib/rocblas/library | grep -q "${GPU_ARCH}" \
        || { echo "No ${GPU_ARCH} rocBLAS kernels in this tarball!"; exit 1; }

    # make ROCm libs visible to the dynamic linker (also during the build)
    printf '/opt/rocm/lib\n/opt/rocm/lib64\n/opt/rocm/extras/lib\n' > /etc/ld.so.conf.d/rocm.conf
    ldconfig

    # register the ROCm OpenCL runtime with the ICD loader (for pyopencl)
    mkdir -p /etc/OpenCL/vendors
    OCL_LIB="$(find /opt/rocm -name 'libamdocl64.so*' | head -n1 || true)"
    if [ -n "${OCL_LIB}" ]; then
        echo "${OCL_LIB}" > /etc/OpenCL/vendors/amdocl64.icd
    else
        echo "WARNING: libamdocl64.so not found in tarball - OpenCL context will be unavailable"
    fi
    ls /etc/OpenCL/vendors
    clinfo -l || true   # no GPU on the build host is fine

    # ROCm environment for the rest of the build
    export ROCM_PATH=/opt/rocm
    export ROCM_HOME=/opt/rocm
    export HIP_PATH=/opt/rocm
    export HIPCC=/opt/rocm/bin/hipcc
    export PATH="/opt/rocm/bin:/opt/rocm/lib/llvm/bin:${PATH}"
    export LD_LIBRARY_PATH="/opt/rocm/lib:/opt/rocm/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

    # install python and packages
    ##############################
    apt-get install -y python3 python3-pip python3-virtualenv

    # install xsuite
    #################
    virtualenv --system-site-packages /xsuite-env
    PIP=/xsuite-env/bin/pip

    # prebuilt CuPy for ROCm from AMD's index (no source build needed)
    ${PIP} install amd-cupy --extra-index-url="${AMD_PYPI_INDEX}"

    # xsuite useful packages
    ${PIP} install siphash24 cpymad h5py pyheadtail pytest pytest-mock


    ${PIP} install xsuite cython tqdm  pyopencl mako
    ${PIP} install "xplt[full]"
    ${PIP} install setuptools
    git clone --depth 1 https://github.com/geggo/gpyfft.git /tmp/gpyfft
    ${PIP} install --no-build-isolation /tmp/gpyfft
    rm -rf /tmp/gpyfft

    #/xsuite-env/bin/xsuite-prebuild regenerate
    ${PIP} freeze

    # cleanup
    ##########
    apt-get purge -y wget '.*-doc$' || true
    # do not apt autoremove -y
    apt-get clean -y
    rm -rf /var/lib/apt/lists/*
    ${PIP} cache purge || true

%environment
    export ROCM_PATH=/opt/rocm
    export ROCM_HOME=/opt/rocm
    export HIP_PATH=/opt/rocm
    export HIPCC=/opt/rocm/bin/hipcc
    export HIPCXX=/opt/rocm/lib/llvm/bin/clang
    export CMAKE_PREFIX_PATH=/opt/rocm
    export GPU_ARCH=gfx908
    export PATH=/opt/rocm/extras/bin:/opt/rocm/bin:/opt/rocm/lib/llvm/bin:$PATH
    export LD_LIBRARY_PATH=/opt/rocm/extras/lib:/opt/rocm/lib:/opt/rocm/lib64:/.singularity.d/libs${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
    # activate the xsuite virtualenv
    export VIRTUAL_ENV=/xsuite-env
    export PATH=/xsuite-env/bin:$PATH
